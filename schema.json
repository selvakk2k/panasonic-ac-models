{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Panasonic AC Model Masterlist Schema",
  "type": "object",
  "required": ["version", "summary", "families"],
  "properties": {
    "version": { "type": "string" },
    "summary": {
      "type": "object",
      "properties": {
        "total_wifi_models": { "type": "integer" },
        "total_wifi_families": { "type": "integer" },
        "updated_at": { "type": "string" }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family_key",
          "series",
          "generation",
          "capacity_class",
          "speed_type",
          "has_wifi",
          "has_heat_mode",
          "has_nanoe",
          "converti_type",
          "indoor_units"
        ],
        "properties": {
          "family_key": { "type": "string" },
          "series": { "type": "string" },
          "generation": { "type": "string" },
          "capacity_class": { "type": "string" },
          "speed_type": { "type": "string", "enum": ["variable", "fixed"] },
          "model_count": { "type": "integer" },
          "has_wifi": { "type": "integer", "enum": [0, 1] },
          "has_heat_mode": { "type": "integer", "enum": [0, 1] },
          "has_nanoe": { "type": "integer", "enum": [0, 1] },
          "converti_type": { "type": "string", "enum": ["8-in-1", "7-in-1", "none"] },
          "variants": { "type": "array", "items": { "type": "string" } },
          "indoor_units": { "type": "array", "items": { "type": "string" } },
          "ac_types": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
